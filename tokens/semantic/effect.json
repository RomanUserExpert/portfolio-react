{
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": "{color.shadow.default}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 12,
          "unit": "px"
        },
        "spread": {
